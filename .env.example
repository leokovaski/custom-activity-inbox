# Copie para .env e preencha

# URL pública onde a activity está hospedada (sem barra no final)
BASE_URL=https://sua-activity.onrender.com

# Segredo JWT do Installed Package no Marketing Cloud
# (Setup > Installed Packages > seu pacote > JWT Signing Secret)
JWT_SECRET=

# Porta local
PORT=3000

# --- OPCIONAL: lookup do nome ATUAL da jornada via REST API ---
# Sem isso, o nome usado é o capturado no momento da configuração da activity
# (fica desatualizado se a jornada for renomeada depois de publicada).
# Crie um componente "API Integration (Server-to-Server)" no Installed Package
# com o escopo "Journeys - Read" e preencha:
SFMC_AUTH_URL=https://SEU-SUBDOMINIO.auth.marketingcloudapis.com
SFMC_CLIENT_ID=
SFMC_CLIENT_SECRET=

# --- PRODUÇÃO EM GRANDE ESCALA (Azure Service Bus) ---
# Com a connection string configurada, o /execute apenas enfileira e responde
# em ms; o worker.js (processo separado) consome a fila e roda a lógica.
# Sem ela, o processamento é inline (dev / baixa escala).
SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_QUEUE=journey-execute

# Mensagens processadas em paralelo por instância do worker
WORKER_CONCURRENCY=20
