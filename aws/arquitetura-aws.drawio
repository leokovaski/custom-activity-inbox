        <!-- Legenda -->
        <mxCell id="legend" value="Fluxo de configuração (não desenhado): o usuário abre o modal da activity no Journey Builder → a UI (servida pela Lambda da API de dentro do jar) salva título/mensagem na própria definição da jornada via Postmonger — sem banco de dados." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1">
