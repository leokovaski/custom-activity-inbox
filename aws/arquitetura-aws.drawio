<mxfile host="app.diagrams.net" agent="claude" version="24.0.0">
  <diagram name="Custom Activity — AWS Serverless" id="custom-activity-aws">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
